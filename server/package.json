{
  "name": "ems-server",
  "version": "1.0.0",
  "private": true,
  "description": "EMS API — Express + Prisma + PostgreSQL",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed/reference.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:test": "tsx scripts/testDb.ts",
    "field-contract": "tsx scripts/fieldContract.ts",
    "grant-leave": "tsx scripts/grantLeave.ts",
    "migration:new": "tsx scripts/newMigration.ts",
    "lint": "tsx scripts/lint.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "papaparse": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
