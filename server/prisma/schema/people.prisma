/// The HR record, and the three tables that hold what must not be read by
/// everyone who can read a name.
///
/// Salary, banking and tax identity live in SEPARATE TABLES rather than as more
/// columns on Employee. That is not tidiness — it is what makes the rule
/// enforceable. With one wide table, hiding salary means every query everywhere
/// must remember to omit those columns, and the one that forgets is the leak.
/// With separate tables the repository simply does not join what the caller may
/// not see, so the data never reaches the process that would serialise it.

/// How this person's attendance reaches the system. Set per employee by an
/// admin — the client's example is 8 of 10 staff on `app`, 2 on `biometric`.
/// Distinct from Attendance.source, which records how one particular row was
/// created: an `app` employee can still have a day corrected by HR.
enum AttendanceMode {
  /// Employee punches in the app. Geofence applies.
  app
  /// Comes from the device by CSV import. No geofence — they are at the machine.
  biometric
  /// HR marks it.
  manual
}

/// The four the existing UI offers. Stored as an enum rather than the display
/// strings ("Full-time") the old app saved, so a report can group on them.
enum EmploymentType {
  full_time
  part_time
  contract
  intern
}

/// Deliberately only the two states the UI has. Leaving is handled by
/// `archivedAt` plus the termination transaction in §A9, which keeps payslips
/// intact — not by inventing enum values nothing sets.
enum EmployeeStatus {
  active
  inactive
}

/// Set by the bank-verification flow. `unverified` is the honest default: a
/// blank status is not the same as "checked and fine".
enum BankVerificationStatus {
  unverified
  pending
  verified
  rejected
}

model Employee {
  id             String @id @default(uuid())
  organizationId String

  employeeCode  String
  fullName      String
  personalEmail String?
  phone         String?
  dateOfJoining DateTime? @db.Date

  /// The last day this person is paid for. Null while they still work here.
  ///
  /// Distinct from `status`: somebody serving notice is still active, and their
  /// final payslip has to stop on this date rather than at the end of the
  /// month. Without it a mid-month leaver is paid for days after they left,
  /// and the overpayment is only discovered when somebody tries to recover it.
  lastWorkingDate DateTime? @db.Date

  /// The employee lifecycle (client §43). Where somebody stands is worked out
  /// from these and their resignation (domain/org/lifecycle.ts): joining date
  /// ahead → joining soon; not onboarded → onboarding; not confirmed → on
  /// probation; confirmed; a resignation → resigned, then serving notice.
  ///
  /// The day HR finished onboarding them. Null while onboarding is open.
  onboardedOn      DateTime?   @db.Date
  /// When their probation ends — the company's probation months from joining,
  /// unless HR set or extended it.
  probationEndDate DateTime?   @db.Date
  /// The day they were confirmed. Null while on probation.
  confirmedOn      DateTime?   @db.Date
  /// Why they left, once their exit is complete.
  exitReason       ExitReason?

  /// Nullable, because nobody should be forced to guess it to save a record.
  ///
  /// Not a demographic nicety: professional tax is gendered by statute in
  /// several states — Maharashtra exempts women up to 25,000 where men pay
  /// from 7,500 — so without this every woman is over-deducted 200 a month.
  /// The EPFO ECR and the ESIC return both require it as well, so the field
  /// is owed to the government whatever payroll does with it.
  ///
  /// Null resolves to the `any` slab, and a state that has only gendered
  /// slabs will deduct nothing until somebody fills this in — visibly wrong
  /// rather than quietly wrong.
  gender Gender?

  employmentType EmploymentType @default(full_time)
  status         EmployeeStatus @default(active)

  departmentId  String?
  designationId String?
  shiftId       String?

  attendanceMode  AttendanceMode  @default(app)
  /// Office, hybrid (home on approved days) or remote (client §33).
  workArrangement WorkArrangement @default(office)

  /// Personal details (client §42). Shown to the person and to whoever reads
  /// statutory details; changed by them only through a profile change request.
  dateOfBirth              DateTime? @db.Date
  nationality              String?
  address                  String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  /// Overrides the organization's values when an employee sits elsewhere.
  country  String @default("IN")
  currency String @default("INR")

  /// Self-relation. Without it the DIRECT_REPORTS data scope cannot exist,
  /// and manager leave approval (Day 14) has nothing to filter on.
  reportingManagerId String?

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  /// Soft delete. Statutory records are never destroyed.
  archivedAt DateTime? @db.Timestamptz(3)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The person's logins (Day 23): an employee login, and a role login beside
  /// it for someone who holds a role. Empty for a record created before any.
  memberships      Membership[]
  reportingManager Employee?    @relation("Reports", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports    Employee[]   @relation("Reports")
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  shift            Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  headsDepartments Department[] @relation("DepartmentHead")

  /// The company this person is the owner of (Day 22), and the companies
  /// that send the leave of people with nobody above them to this person.
  ownerOf           Organization?  @relation("OrganizationOwner")
  noManagerApprover Organization[] @relation("NoManagerApprover")

  financials        EmployeeFinancial[]
  bankAccount       EmployeeBankAccount?
  statutoryIdentity EmployeeStatutoryIdentity?
  leaveLedger       LeaveLedgerEntry[]
  attendance        Attendance[]
  leaveRequests     LeaveRequest[]
  esiCoverage       EsiCoverage[]
  payslips          Payslip[]
  tdsDirectives     EmployeeTdsDirective[]
  monthlyEntries    EmployeeMonthlyEntry[]
  documents         EmployeeDocument[]
  employmentEvents  EmploymentEvent[]
  resignations      Resignation[]
  requests          EmployeeRequest[]
  loans             EmployeeLoan[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, archivedAt])
  @@index([reportingManagerId])
  @@index([organizationId, departmentId])
}

/// Salary. Requires `employee:compensation:read`.
///
/// EFFECTIVE-DATED rather than overwritten, which is why this is a list on
/// Employee and not one row. A payslip for March must be recomputable from
/// March's salary, and a raise in April must not silently change what last
/// month's payslip says. Overwriting is how payroll history becomes fiction.
model EmployeeFinancial {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String

  /// Decimal, never Float. 0.1 + 0.2 is not 0.3 in binary floating point, and
  /// money that is out by a paisa per row is money that does not reconcile.
  ctc Decimal @db.Decimal(12, 2)

  effectiveFrom DateTime  @db.Date
  /// Null means "current". Set when a later record supersedes this one.
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// What this person is paid, component by component.
  ///
  /// ROWS RATHER THAN COLUMNS, and the reason is the client's own list: it ends
  /// with Incentive, which had no column, so it could not be stored at all. The
  /// next component after that would have needed a migration and a deploy —
  /// which is how a payroll system ends up with an "Other Allowance" column
  /// that six different things are stuffed into.
  components EmployeeSalaryComponent[]

  @@unique([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, employeeId])
}

/// Where salary is paid. Requires `employee:bank:read`.
model EmployeeBankAccount {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String @unique

  bankName          String
  accountHolderName String
  /// Stored as a string, never a number — leading zeros are significant and an
  /// integer would silently eat them.
  accountNumber     String
  ifsc              String
  branch            String?
  accountType       String?

  verificationStatus  BankVerificationStatus @default(unverified)
  verificationRemarks String?
  verifiedAt          DateTime?              @db.Timestamptz(3)
  verifiedByUserId    String?

  /// Cancelled cheque or passbook page. The KEY in object storage, not a URL —
  /// a stored URL either expires or is public forever.
  proofKey         String?
  proofFileName    String?
  /// The proof's type from the allow-list, its size and hash — checked on
  /// every read, as for every other stored file.
  proofContentType String?
  proofBytes       Int?
  proofSha256      String?
  proofUploadedAt  DateTime? @db.Timestamptz(3)

  /// Who entered these details: the employee themselves (Day 19's
  /// self-service), or Accounts from a cheque handed in.
  submittedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Tax and statutory identifiers. Requires `employee:identity:read`.
///
/// Separate from banking because they are separate data classes held by
/// different roles: Accounts needs the bank account to pay someone, and has no
/// business holding their PAN.
model EmployeeStatutoryIdentity {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String @unique

  pan             String?
  /// Universal Account Number. Null until EPFO issues one — and it is NEVER
  /// derived from anything else. The audit found a screen inventing a UAN from
  /// the PAN, which produces a plausible-looking number that is simply wrong.
  uan             String?
  pfAccountNumber String?
  esiNumber       String?
  /// Professional tax is levied per state, and an employee may sit in a
  /// different state from the head office.
  ptState         String?

  /// Whether provident fund applies to this person at all.
  ///
  /// Per-employee, not per-company: an international worker, a re-employed
  /// pensioner and an "excluded employee" who joined above the ceiling and was
  /// never a member are all outside PF while their colleagues are inside it.
  /// One company-wide switch would deduct from people it must not.
  pfApplicable Boolean @default(true)

  /// Was this person already a member of the provident fund somewhere else?
  ///
  /// Decides EPS membership, and only the employee can answer it — it is a fact
  /// about their previous employment. NULL means nobody has asked yet, which is
  /// treated as "no": a genuine new entrant above the ceiling is excluded from
  /// the pension scheme, and that is the outcome the 2014 rule intends. Getting
  /// it wrong changes the split between EPS and EPF, never the total, so it is
  /// invisible on the payslip and wrong on every return until someone asks.
  hasPriorPfMembership Boolean?

  /// Is this person a member of the pension scheme (EPS), as their PF record
  /// with EPFO has it? Recorded by HR from that record. NULL: payroll works it
  /// out from what they joined on (statutory.isEpsMember). Recorded, it holds
  /// whatever later changes what counts as PF wages, the pension ceiling, or
  /// the Labour Codes' wages rule — membership is a fact about the person, not
  /// a figure to recompute every month.
  epsMember Boolean?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Recorded for statutory returns and gendered professional tax.
///
/// `other` exists because people do; it maps to the `any` professional-tax
/// slab, which is the only honest reading of a table the state wrote with
/// two options.
enum Gender {
  male
  female
  other
}
