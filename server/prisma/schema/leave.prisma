/// Leave types and the ledger that produces a balance.
///
/// Models only today, so Day 8's employee writes can reference them. The leave
/// module itself is Days 13-14.

model LeaveType {
  id             String @id @default(uuid())
  organizationId String

  name String
  /// Short form used in tables and exports: CL, SL, EL, CO, LOP.
  code String

  /// Days granted per leave year. Decimal because half-days are real.
  annualQuota Decimal @default(0) @db.Decimal(5, 2)

  /// Unpaid leave still needs a type, so that it can be recorded and shown —
  /// it simply does not add to the amount payable.
  isPaid Boolean @default(true)

  /// Whether an unused balance survives into the next leave year, and how much.
  carryForward    Boolean @default(false)
  carryForwardCap Decimal @default(0) @db.Decimal(5, 2)

  /// The type's rules (client §36). Each defaults to what applied before it
  /// existed: no notice, no cap, open to everybody from their first day,
  /// granted for the year at once, half days allowed, weekends and holidays
  /// not counted, never encashed.
  ///
  /// Days ahead an application must be made. A day already started (sick
  /// leave applied on return) is not refused by this — only one too soon.
  minNoticeDays        Int          @default(0)
  /// The most days one application may cover. Null: no limit beyond the balance.
  maxDaysPerRequest    Decimal?     @db.Decimal(5, 2)
  /// Days of service before the type may be used — 80 days for maternity
  /// benefit under the Code on Social Security, for example.
  eligibleAfterDays    Int          @default(0)
  /// Who may use it, when only one gender may (maternity, paternity). Null: anybody.
  eligibleGender       Gender?
  /// Granted for the whole year at once, or earned a twelfth a month — the
  /// grant is the same, what may be USED by a month is what has been earned.
  accrual              LeaveAccrual @default(yearly)
  halfDayAllowed       Boolean      @default(true)
  /// Counts the weekends and holidays inside a request (maternity leave runs
  /// in calendar days). Off: only working days are counted.
  countsNonWorkingDays Boolean      @default(false)
  /// Unused days may be turned into pay, at most this many a leave year.
  encashable           Boolean      @default(false)
  encashMaxDaysPerYear Decimal?     @db.Decimal(5, 2)

  /// Who gets how much, and from when (client, 9 Oct 2026). Each defaults to
  /// what applied before it existed.
  ///
  /// What somebody who joins partway through a leave year is granted of it.
  joinerGrant             LeaveJoinerGrant @default(months_left)
  /// Usable only from the day somebody is confirmed — the end of probation
  /// (Employee.confirmedOn). Checked beside `eligibleAfterDays`: both hold.
  usableAfterConfirmation Boolean          @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries LeaveLedgerEntry[]
  requests      LeaveRequest[]
  entitlements  EmployeeLeaveEntitlement[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
}

/// Every movement in a leave balance, as an append-only list.
///
/// A LEDGER, not a balance column. The obvious design is `leave_balances` with
/// a number that goes up and down — and the old schema did exactly that. The
/// problem shows up the first time someone asks "why does Priya have 4.5 days
/// when she should have 6?": a mutated number has no answer. It cannot say what
/// was granted, what was taken, what was cancelled, or who adjusted it.
///
/// Here the balance is the SUM of these rows, so the question always has an
/// answer, and a wrong balance is fixed by adding a correcting entry rather
/// than by editing history.
model LeaveLedgerEntry {
  id             String @id @default(uuid())
  organizationId String

  employeeId  String
  leaveTypeId String

  /// The leave year this belongs to. Which month a leave year starts in is an
  /// organization setting (Day 9) — this records the year it was applied to,
  /// not the calendar year of the date.
  leaveYear Int

  /// Positive grants days, negative consumes them. One column rather than
  /// separate credit and debit, so a balance is SUM(days) and cannot disagree
  /// with itself.
  days Decimal @db.Decimal(5, 2)

  reason LeaveLedgerReason

  /// Set when this entry came from an approved request, so a cancellation can
  /// find and reverse exactly the right rows.
  leaveRequestId String?

  /// Free text for a manual adjustment. Required by the service when the
  /// reason is `adjustment` — an unexplained correction is the thing this
  /// whole design exists to prevent.
  note String?

  /// Who caused it. Null for entries the system grants automatically.
  createdByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, leaveYear])
  @@index([organizationId, leaveTypeId])
}

enum LeaveLedgerReason {
  /// The annual quota, granted at the start of a leave year.
  opening_grant
  /// Unused days carried in from last year.
  carry_forward
  /// An approved leave request.
  consumed
  /// A cancelled or reversed request giving days back.
  reversal
  /// A manual correction by HR. Requires a note.
  adjustment
  /// Turned into pay by an approved encashment request (client §36).
  encashed
}

/// What a leave type grants somebody who joins partway through a leave year.
enum LeaveJoinerGrant {
  /// The months left in the year, the joining month counted.
  months_left
  /// The whole months left: nothing for a month joined partway — joined on its
  /// first day, it counts.
  months_after_joining
  /// The whole year's days, whenever in it they join.
  full_year
}

/// One person's own days a year of a leave type, in place of the type's
/// (client, 9 Oct 2026): fifteen days of casual leave for one person where the
/// company gives twelve. Their grant is reckoned from this, by the type's other
/// rules; changing it during a year adds or takes away the difference at once,
/// as a ledger entry. No row: the type's days apply.
model EmployeeLeaveEntitlement {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String

  annualQuota Decimal @db.Decimal(5, 2)
  /// Why, as given by whoever set it.
  note        String?

  updatedByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, leaveTypeId])
  @@index([organizationId, leaveTypeId])
}

/// That one person was told, for a leave year, of the days that would lapse at
/// its end (client, 10 Oct 2026) — so they are told once. Kept apart from the
/// notice itself: that one they may clear from the bell.
model LeaveYearEndNotice {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  leaveYear      Int

  /// The days they were told would lapse.
  days      Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, leaveYear])
}

/// How a leave type's yearly grant becomes usable.
enum LeaveAccrual {
  /// All of it from the start of the year.
  yearly
  /// A twelfth for each month of the year reached — by the month a leave starts in.
  monthly
}

/// One application for leave.
///
/// The REQUEST and the LEDGER are separate on purpose. This row is what
/// somebody asked for and what was decided; the ledger is what it cost them.
/// Keeping them apart is what makes a cancellation possible: the request moves
/// to `cancelled` and a reversing entry gives the days back, and both facts
/// survive. A single mutable "days remaining" number can express neither.
model LeaveRequest {
  id             String @id @default(uuid())
  organizationId String

  employeeId  String
  leaveTypeId String

  fromDate DateTime @db.Date
  toDate   DateTime @db.Date

  /// Which days inside the range are half days, as calendar dates.
  ///
  /// An array rather than a `isHalfDay` flag, because a week's leave can have a
  /// half day at either end — somebody leaving at lunch on Friday and returning
  /// at lunch the following Thursday. A single boolean cannot say which.
  halfDayDates    String[] @default([])
  /// Which half of each of those days is taken (client §37): a date to
  /// "first_half" or "second_half". A date missing here was applied for before
  /// halves were asked, and is just a half day.
  halfDaySessions Json     @default("{}")

  /// What this actually costs, computed by domain/leave/leaveDays — weekends
  /// and holidays already removed. Stored rather than recomputed, so a holiday
  /// added to the calendar next year does not silently change what somebody was
  /// charged last year.
  days Decimal @db.Decimal(5, 2)

  /// The leave year this is charged against, from OrganizationPolicy. Stored
  /// because the year boundary can move, and a request must stay in the year it
  /// was taken from.
  leaveYear Int

  reason String

  status LeaveStatus @default(pending)

  /// One application in parts (client, 9 Oct 2026): the days a paid type's
  /// balance covers, and the rest as unpaid leave. Each part is a request of
  /// its own type — so the ledger, payroll and reports read it as they read any
  /// — and the parts share this id: they are applied for, decided, withdrawn
  /// and reversed together. Null for an application of one type.
  groupId String?

  appliedAt        DateTime  @default(now()) @db.Timestamptz(3)
  reviewedByUserId String?
  reviewedAt       DateTime? @db.Timestamptz(3)
  reviewNote       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  ledgerEntries LeaveLedgerEntry[]

  @@index([organizationId, employeeId, leaveYear])
  @@index([organizationId, status])
  @@index([organizationId, fromDate])
  @@index([groupId])
}

enum LeaveStatus {
  pending
  approved
  rejected
  /// Withdrawn by the employee, or reversed after approval. Either way the
  /// days come back through a ledger entry rather than by editing history.
  cancelled
}
