/// One row per employee per day.
///
/// The old schema had none of this: no hours, no source, no geofence evidence.
/// Each of those absences is a question the system could not answer — "how long
/// did she work?", "who marked this?", "was he actually at the office?" — and
/// every one of them gets asked eventually, usually in an argument about pay.

/// HOW a particular row came to exist. Distinct from Employee.attendanceMode,
/// which is the POLICY for that person.
///
/// Both are needed: an `app` employee may still have one day corrected by HR.
/// Their mode stays `app`; that row's source is `manual`. A single field cannot
/// express the difference, and without it nobody can tell who created a record.
enum AttendanceSource {
  /// The employee punched in through the app. Geofence applied.
  punch
  /// Imported from the biometric device by CSV (Day 12).
  biometric
  /// Entered by HR on someone's behalf.
  manual
  /// Generated from an approved leave request (Day 14), so a leave day is a
  /// real row rather than a gap that reports have to interpret.
  leave
  /// Set by an approved attendance correction request (client §29).
  correction
}

enum AttendanceStatus {
  present
  half_day
  absent
  on_leave
  holiday
  weekly_off
}

model Attendance {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String

  /// The calendar day this belongs to, in the COMPANY'S timezone — computed by
  /// domain/shared/dates.ts, never by toISOString(). A night-shift punch at
  /// 00:30 IST is 19:00 UTC the previous day, and filing it under the wrong
  /// date is a bug that shows up as one employee whose hours never add up.
  date DateTime @db.Date

  /// Instants, not times-on-a-day. This is what makes an overnight shift work
  /// without any special handling: the timestamps carry their own dates.
  checkIn  DateTime? @db.Timestamptz(3)
  checkOut DateTime? @db.Timestamptz(3)

  status AttendanceStatus @default(absent)
  source AttendanceSource @default(punch)

  /// COMPUTED AND STORED, not derived on read.
  ///
  /// The client asked to see both daily hours and a monthly total. Recomputing
  /// from timestamps on every read would be fine until the shift's break
  /// minutes change — and then last month's totals would silently change too.
  /// Storing the number freezes what was actually worked.
  hoursWorked Decimal? @db.Decimal(5, 2)

  /// Which shift this day was measured against, captured at punch time. The
  /// employee's shift may be reassigned later; this row must still be readable
  /// against the one that applied on the day.
  shiftId       String?
  expectedHours Decimal? @db.Decimal(4, 2)

  /// The four geofence columns. Evidence, not a decision — the decision is
  /// `geofenceVerified`, and these are what allow it to be explained or
  /// disputed afterwards.
  checkInLatitude       Decimal? @db.Decimal(10, 7)
  checkInLongitude      Decimal? @db.Decimal(10, 7)
  /// How far from the office the reading put them.
  checkInDistanceMeters Int?
  /// The phone's own estimate of how wrong it might be. Without this a 30 m
  /// fence cannot be defended: "25 m away" means nothing until you know whether
  /// that is give-or-take five metres or fifty.
  checkInAccuracyMeters Int?

  /// Null means no check was made — a biometric or manual row, where a GPS
  /// reading would be meaningless rather than merely missing.
  geofenceVerified Boolean?

  /// Where the day was worked from (client §33), and the device that checked
  /// in (client §31) — the browser's own description, cut short.
  workMode      WorkMode?
  checkInDevice String?
  /// The method the day was checked in with on the app (client, 14 Oct
  /// 2026): its check-out is proved the same way, whatever the company has
  /// chosen since. Null on a day the app did not begin.
  punchMethod   PunchMethod?

  /// Measured against the shift when the day has its times (client §34–35).
  /// Null: no shift, or no time to measure. Late and early are the minutes
  /// past the start and short of the end, recorded only beyond the grace;
  /// overtime the minutes past the expected hours, once past the threshold.
  /// Overtime here is what was WORKED — what is paid is an approved request.
  lateMinutes         Int?
  earlyLeavingMinutes Int?
  overtimeMinutes     Int?

  /// Free text. HR's reason for a manual entry or a correction.
  note String?

  /// Who created or last changed this row, when it was not the employee.
  markedByUserId String?

  /// An absent day with no punch that approved leave took over (client, 10 Oct
  /// 2026): what it was before, so the calendar says leave once leave is
  /// approved — and a reversal puts the day back as it was. Null otherwise.
  statusBeforeLeave AttendanceStatus?
  sourceBeforeLeave AttendanceSource?

  /// The fingerprint machine's word on an app day (client, 11 Oct 2026): its
  /// first and last scan that day (the last null with one scan), what the
  /// match came to, and when the file was imported. The app's times stay the
  /// record; these confirm them. Null: not matched yet.
  machineFirstScan DateTime?     @db.Timestamptz(3)
  machineLastScan  DateTime?     @db.Timestamptz(3)
  machineMatch     MachineMatch?
  machineCheckedAt DateTime?     @db.Timestamptz(3)
  /// A day the company's rule made absent for not being on the machine: what
  /// it was before, so a later file that has it puts it back.
  statusBeforeMachine AttendanceStatus?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  punchEvidence PunchEvidence[]

  /// One row per person per day — the client was explicit about one punch pair.
  /// Enforced by the database, so a double-submitted form cannot create two.
  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, employeeId, date])
}

/// An app day matched against the fingerprint machine's file (client, 11 Oct 2026).
enum MachineMatch {
  /// A scan that day, within the minutes allowed of the app's times.
  confirmed
  /// A scan that day, further from the app's times than allowed — a note for HR.
  time_differs
  /// No scan that day at all.
  not_on_machine
  /// No app punch that day: the day is the machine's, filled from its file.
  from_machine
}

/// What a company does with an app day the machine has no scan for.
enum MachineMissing {
  /// Flag it for HR; the day stands.
  flag
  /// Mark the day absent (cut from pay, the absent alert sent).
  absent
}

/// How an app punch is proved (client, 14 Oct 2026). Exactly one, never none.
enum PunchMethod {
  /// Inside the office fence, from a phone.
  location
  /// A live photo from the front camera.
  selfie
  /// Both: the location first — no location, no camera — then the photo.
  location_selfie
}

/// Which way a punch went.
enum PunchAction {
  in
  out
}

/// Why an app punch was refused — kept, because "he tried from 2 km away at
/// 09:58" is exactly what HR needs to see (client, 11 Oct 2026).
enum PunchRefusal {
  /// The reading's point was outside the office radius.
  outside
  /// The reading was too vague to decide.
  unreliable
  /// From a computer, with "phones only" on.
  not_phone
  /// From a phone HR has not approved, with "one phone per employee" on.
  device_waiting
  /// With no photo, with "selfie" on.
  no_photo
}

/// A sign a punch may not be what it seems — for HR to look at, never a
/// verdict (domain/attendance/punchSignals.ts).
enum PunchFlag {
  frozen_readings
  repeated_spot
  too_precise
  stale_reading
  not_a_phone
  /// A phone not seen in the person's punches of the last two months — or no phone key at all.
  new_device
  /// The very same photo, to the byte, as an earlier accepted punch of theirs.
  repeated_photo
  /// A Mac's browser claiming a touch screen: how an iPad describes itself, and what a laptop can be made to say.
  mac_with_touch
  /// A location kept but not fenced (Location + Selfie) too vague to say where — over 100 m. Taken, and said.
  location_vague
}

/// Where one person's phone stands, with "one phone per employee" on.
enum PunchDeviceStatus {
  /// Their phone: punches from it are taken.
  approved
  /// Another phone, refused until HR approves it.
  waiting
  /// A phone HR took off, or the old one when a new one was approved.
  retired
}

/// One person's phone (client, 11 Oct 2026: one phone per employee, a setting).
/// Known by a random key the phone's browser keeps — stored only as its hash.
/// Rows exist only with the setting on: the first phone is approved by itself,
/// another waits for HR, and approving it retires the old one.
model PunchDevice {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String

  /// sha256 of the key the browser keeps — never the key itself.
  keyHash String
  /// "Android · Chrome", from the browser's description when first seen.
  label   String?
  status  PunchDeviceStatus @default(waiting)

  firstSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime  @default(now()) @db.Timestamptz(3)
  /// Who approved or retired it, and when. Null: the first phone, approved by itself.
  decidedByUserId String?
  decidedAt       DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, keyHash])
  @@index([organizationId, status])
}

/// One app punch, in or out — accepted or refused — with everything that
/// decided it (client, 11 Oct 2026: check-in security). The day's own row keeps
/// the check-in summary it always had; this keeps the whole story, check-out
/// included, so a punch can be explained or disputed afterwards.
model PunchEvidence {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String

  /// The day it was for, in the company's time zone. With the day's row once
  /// there is one: a refused check-in has none.
  date         DateTime @db.Date
  attendanceId String?

  action PunchAction
  /// Null when it was accepted.
  refusedFor PunchRefusal?

  /// When the button was pressed (the start token) and when the punch reached
  /// the server — both by the server's clock.
  startedAt DateTime @db.Timestamptz(3)
  at        DateTime @default(now()) @db.Timestamptz(3)

  /// Where the day was worked from: an office day is checked against the fence.
  workMode WorkMode?

  /// The reading the punch was judged by (the most precise of the burst) and
  /// how it measured against the office. Null with no reading.
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  accuracyMeters Int?
  distanceMeters Int?
  /// Whether the office fence was applied to it. False: an away day, read but not checked.
  fenceApplied   Boolean @default(false)

  /// Every reading of the burst, as the phone gave them: [{ latitude,
  /// longitude, accuracyMeters, at }]. Evidence, never a decision on its own.
  readings Json?

  /// The address it came from, and the browser's description of itself, cut short.
  ip        String?
  userAgent String?

  /// The signs it may not be what it seems (Layer 4): for HR's list of
  /// suspicious punches. Empty: nothing to say.
  flags PunchFlag[] @default([])

  /// The phone, by the hash of the key its browser keeps (Layer 6). Null: a
  /// page that sent none.
  deviceKeyHash String?

  /// The selfie taken with it (Layer 5): where it is stored, its hash, its
  /// size. Null: none was asked for, or the nightly job removed it once the
  /// company's days for keeping it were up.
  photoKey   String?
  photoSha   String?
  photoBytes Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance   Attendance?  @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, attendanceId])
}
