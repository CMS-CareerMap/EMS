/// The lists an employee record points at: department, designation, shift.
///
/// Tables rather than free text on Employee, because the old app stored these
/// as strings typed into a box. That produces "Sales", "sales" and "Sales "
/// as three departments, and a headcount report that cannot be trusted.

model Department {
  id             String @id @default(uuid())
  organizationId String

  name String

  /// The person who heads it. Optional — a department can exist before anyone
  /// is appointed to lead it, which is the normal case when setting up.
  headEmployeeId String?

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  head         Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  employees    Employee[]

  /// Scoped unique: two companies may both have a "Sales".
  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
}

model Designation {
  id             String @id @default(uuid())
  organizationId String

  name String

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
}

/// A working pattern. The client asked for configurable shift hours so that
/// "did they work their day?" has an answer (§A1.5).
model Shift {
  id             String @id @default(uuid())
  organizationId String

  name String

  /// Wall-clock labels in HH:mm, NOT instants.
  ///
  /// A shift starts at nine in the morning wherever the employee is; it is not
  /// a moment in time and has no timezone of its own. Storing these as DateTime
  /// would attach a date and a zone to something that has neither, and every
  /// read would need them stripped off again.
  startTime String
  endTime   String

  /// Unpaid break, subtracted when hours worked are computed (Day 11). None by
  /// default: the client's people take lunch whenever they like, so a day is
  /// check-in to check-out and the full-day minimum allows for lunch (client,
  /// 8 Oct 2026). A company that docks a fixed break sets it here.
  breakMinutes Int @default(0)

  /// The shift's length in hours; the client's is 9. Overtime counts past it,
  /// and a shift with no minimums of its own reads full and half days as
  /// fractions of it. Decimal because half-hours are real: 8.5 is a common shift.
  expectedHours Decimal @default(9) @db.Decimal(4, 2)

  /// The shift's rules (client §34). Every one defaults to what the system did
  /// before it had them, so a company that never opens them pays as it did.
  ///
  /// Minutes either side of the shift that count as neither late nor leaving
  /// early.
  graceMinutes         Int      @default(0)
  /// Arriving more than this many minutes after the start makes the day a half
  /// day at best. Null: arriving late is marked, never costs a day.
  lateThresholdMinutes Int?
  /// Leaving more than this many minutes before the end makes the day a half
  /// day at best. Null: leaving early is marked, never costs a day.
  earlyLeavingMinutes  Int?
  /// Hours worked for a full day and for a half day; under the half-day figure
  /// the day is absent. The client's (8 Oct 2026): 8 and 4.5 on a nine-hour
  /// shift, given to the shifts a company starts with. Null: three quarters and
  /// half of the expected hours.
  minFullDayHours      Decimal? @db.Decimal(4, 2)
  minHalfDayHours      Decimal? @db.Decimal(4, 2)
  /// Work past the expected hours counts as overtime (client §35) once it
  /// reaches this many minutes — and then all of it counts.
  overtimeAfterMinutes Int      @default(30)

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  attendance   Attendance[]

  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
}
