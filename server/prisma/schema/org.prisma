/// The company. One row today; the multi-tenant phase adds rows, not columns.
///
/// Every tenant-scoped table carries organizationId, and every unique
/// constraint on those tables includes it. Adding that after go-live is the
/// single most expensive migration a SaaS product ever does; it costs nothing
/// now.

model Organization {
  id String @id @default(uuid())

  name      String
  legalName String?

  /// The Company tab collects every one of these and the old backend stored
  /// none of them — the form saved, showed a tick, and discarded the lot.
  gstin       String?
  pan         String?
  addressLine String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  website     String?

  /// How dates are rendered for this company. A display preference, never a
  /// storage format — every date is stored as a date and formatted on the way out.
  dateFormat String @default("DD/MM/YYYY")

  /// Drives the payslip template and how amounts are rendered.
  /// Statutory calculation is India-only for v1 — see the build guide A1.5.
  country  String @default("IN")
  currency String @default("INR")

  /// Every date rule takes this as an argument. Nothing reads the machine clock.
  timezone String @default("Asia/Kolkata")

  /// The largest file anybody may upload, in MB. The client chose 2 MB; the
  /// server's own ceiling is 10 MB whatever this says.
  maxUploadMb Int @default(2)

  /// The employee lifecycle (client §43): how long a new joiner's probation
  /// runs, and the notice a resignation gives — the company's own, set in
  /// Settings → Employee lifecycle.
  probationMonths  Int @default(6)
  noticePeriodDays Int @default(30)

  /// The owner (Day 22): the one person at the top of the company tree whose
  /// own leave, and own items generally, need nobody's approval. Marked by the
  /// Super Admin, never inferred: somebody left without a manager by mistake
  /// must not skip approval too. Unique, so there is at most one.
  ownerEmployeeId String?   @unique
  owner           Employee? @relation("OrganizationOwner", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)

  /// Settings → Approvals (Day 22), with the client's defaults.
  /// Who decides for somebody with nobody above them: this person, or — when
  /// null — the Super Admin.
  leaveNoManagerApproverId String?
  leaveNoManagerApprover   Employee?           @relation("NoManagerApprover", fields: [leaveNoManagerApproverId], references: [id], onDelete: SetNull)
  /// Who may decide instead when the reporting manager is away.
  leaveBackup              LeaveBackupApprover @default(super_admin)
  /// Who may cancel leave already approved.
  leaveReversal            LeaveReversalBy     @default(manager_or_super_admin)

  /// Who decides each kind of request (client §28–29), Settings → Approvals.
  /// The person they report to, as with leave — except a profile change,
  /// which HR reviews (client §27).
  correctionApprover RequestApprover @default(manager)
  wfhApprover        RequestApprover @default(manager)
  overtimeApprover   RequestApprover @default(manager)
  profileApprover    RequestApprover @default(hr)
  encashmentApprover RequestApprover @default(hr)
  /// Whether working from home (or on duty) still needs a location reading at
  /// check-in (client §32). Off: the approved request is enough.
  wfhGpsRequired     Boolean         @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  roles       Role[]
  employees   Employee[]

  departments  Department[]
  designations Designation[]
  shifts       Shift[]

  employeeFinancials          EmployeeFinancial[]
  employeeBankAccounts        EmployeeBankAccount[]
  employeeStatutoryIdentities EmployeeStatutoryIdentity[]

  leaveTypes         LeaveType[]
  leaveLedgerEntries LeaveLedgerEntry[]

  policies  OrganizationPolicy[]
  ptSlabs   PtSlab[]
  holidays  Holiday[]
  geofences GeofenceLocation[]

  attendance    Attendance[]
  leaveRequests LeaveRequest[]

  salaryComponents         SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  esiCoverage              EsiCoverage[]
  payrollRuns              PayrollRun[]
  payslips                 Payslip[]
  payslipLines             PayslipLine[]
  tdsDirectives            EmployeeTdsDirective[]
  monthlyEntries           EmployeeMonthlyEntry[]
  bankFileTemplates        BankFileTemplate[]

  documentTypes        DocumentType[]
  employeeDocuments    EmployeeDocument[]
  companyDocuments     CompanyDocument[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]

  employmentEvents EmploymentEvent[]
  resignations     Resignation[]
  requests         EmployeeRequest[]
  loans            EmployeeLoan[]
  loanRecoveries   LoanRecovery[]
  emailOutbox      EmailOutbox[]

  auditLogs AuditLog[]
}

/// Who may decide a request instead of a reporting manager who is away.
enum LeaveBackupApprover {
  /// Any Super Admin (the client's choice).
  super_admin
  /// The manager's own reporting manager, one step further up the tree.
  next_up
  /// Nobody: the request waits for the manager.
  none
}

/// Who may cancel leave that has already been approved.
enum LeaveReversalBy {
  /// The person's reporting manager, or a Super Admin (the client's choice).
  manager_or_super_admin
  super_admin_only
}
