/// Salary structure as ROWS, not columns.
///
/// The client's confirmed list is Basic, HRA, DA, Conveyance, Special Allowance
/// and Incentive (§A1.5) — but it is a list they chose, not a law. Modelling it
/// as columns means the day they want a "Site Allowance" it becomes a
/// migration, a schema change and a deployment. As rows it is somebody adding a
/// line in Settings.
model SalaryComponent {
  id             String @id @default(uuid())
  organizationId String

  /// Short code used on the payslip and in exports: BASIC, HRA, DA.
  code  String
  label String

  type ComponentType @default(earning)

  /// Where the amount comes from: the salary record, or a fresh entry each
  /// month.
  ///
  /// The client's own rule (§A1.5): Incentive "is manually entered, not
  /// computed — an authorised role sets the amount per employee per month".
  /// Stored on the salary record instead, it would be paid every month at the
  /// same figure, which is a raise wearing an incentive's name. And it would be
  /// prorated for a short month, when an incentive is a sum somebody decided on
  /// rather than a rate for days worked.
  entry ComponentEntry @default(fixed)

  /// Whether this forms part of PF wages.
  ///
  /// NOT a fixed answer. The 2019 Supreme Court ruling says an allowance that
  /// is ordinarily and universally paid counts — so a "special allowance" paid
  /// to everybody may well be PF wages. Which ones count is the accountant's
  /// call, recorded here rather than assumed in code.
  countsForPf Boolean @default(false)

  /// Whether it is taxable. Conveyance had an exemption until 2018 and things
  /// like this change; a flag survives the change, a hardcoded rule does not.
  taxable Boolean @default(true)

  /// Display order on the payslip. Earnings and deductions each ordered within
  /// their own section.
  displayOrder Int @default(0)

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// NoAction, not Cascade: deleting a component that somebody is paid would
  /// silently remove it from their salary, so it is refused — archive instead.
  /// NoAction rather than Restrict because Postgres checks RESTRICT the instant
  /// a row goes, so deleting a whole organization could trip it mid-cascade;
  /// NoAction waits until the statement finishes and both rows are gone.
  employeeAmounts EmployeeSalaryComponent[]
  monthlyEntries  EmployeeMonthlyEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, archivedAt])
}

enum ComponentType {
  earning
  deduction
}

/// How a salary component gets its amount.
enum ComponentEntry {
  /// On the effective-dated salary record. Prorated by paid days.
  fixed
  /// Entered for one employee for one month, and paid as entered. Never
  /// prorated, never carried to the next month, never guessed when missing.
  monthly
}

/// Whether one employee is covered by ESI for one contribution period.
///
/// THE WHOLE POINT OF THIS TABLE is that the answer is decided ONCE, at the
/// start of the period or on joining, and then does not change. The current
/// code re-tests every month (Payroll.jsx:23), which produces an employee who
/// drifts in and out of ESI as their gross moves — wrong, and impossible to
/// explain to them.
///
/// Periods are 1 Apr–30 Sep and 1 Oct–31 Mar. Somebody covered in April stays
/// covered until September even after a raise; somebody above the threshold in
/// April stays out until October even if their wages fall.
model EsiCoverage {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  covered Boolean

  /// The wage RATE the decision was made on — not the amount paid that month.
  /// Stored so the decision can be explained a year later without recomputing
  /// it from data that has since changed.
  lockedWageRate Decimal @db.Decimal(12, 2)

  /// Why, in words. "Wage rate 19,000 at period start, threshold 21,000."
  reason String

  decidedAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, periodStart])
  @@index([organizationId, periodStart])
}

/// One component of one person's pay, at one point in their salary history.
///
/// The amount lives here rather than in a column on EmployeeFinancial so that
/// the set of components is DATA. A company that adds "Shift Allowance" inserts
/// a SalaryComponent and starts filling in amounts; nobody migrates anything.
///
/// Hangs off EmployeeFinancial rather than off Employee directly, so a raise is
/// a new effective-dated envelope with its own set of amounts and the old one
/// stays exactly as it was. Recomputing an old payslip has to see the old
/// numbers, and that is only true if the old numbers were never overwritten.
model EmployeeSalaryComponent {
  id             String @id @default(uuid())
  organizationId String

  employeeFinancialId String
  salaryComponentId   String

  /// Decimal, never Float — the monthly amount at a full month's attendance.
  /// Proration happens at calculation time and is never stored here.
  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financial    EmployeeFinancial @relation(fields: [employeeFinancialId], references: [id], onDelete: Cascade)
  component    SalaryComponent   @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction)

  /// One amount per component per salary record. Without this a duplicate row
  /// silently doubles somebody's HRA, and the payslip still adds up.
  /// organizationId leads, as on every compound unique here — the tenant
  /// conformance test insists, so that no lookup by this key can ever be
  /// answered from another company's rows. It also serves as the index for
  /// "this salary record's components", so no separate index is needed.
  @@unique([organizationId, employeeFinancialId, salaryComponentId])
}

/// One month's payroll for the whole company.
///
/// A run is what turns calculations into payslips. Before it, every figure is
/// a preview; after it, each payslip is a snapshot that no later change to a
/// salary, a rate or an attendance row can reach.
///
/// One per month. A second run for the same month would be two sets of
/// payslips for one period, and nobody could say which was paid. A draft that
/// is wrong is recalculated or discarded — never run a second time beside it.
model PayrollRun {
  id             String @id @default(uuid())
  organizationId String

  year  Int
  /// 1–12.
  month Int

  status PayrollRunStatus @default(draft)

  /// The day-counting rules the run used, as they stood. Also on every
  /// payslip; here so the run can be read without opening one.
  lopBasis     LopBasis
  sandwichRule Boolean

  /// Totals over the payslips, written in the same transaction as they are.
  employeeCount   Int
  grossEarnings   Decimal @db.Decimal(14, 2)
  totalDeductions Decimal @db.Decimal(14, 2)
  netPayable      Decimal @db.Decimal(14, 2)
  employerPf      Decimal @db.Decimal(14, 2)
  employerEsi     Decimal @db.Decimal(14, 2)

  /// About the run as a whole — who was left out of it, and why.
  warnings String[] @default([])

  createdByUserId String?
  /// When the payslips were last worked out. A recalculated draft moves this;
  /// createdAt stays the day the run was opened.
  calculatedAt    DateTime @db.Timestamptz(3)

  /// Signed off: by whom and when. Cleared if the run is reopened.
  approvedByUserId String?
  approvedAt       DateTime? @db.Timestamptz(3)
  /// The approver was told of days nobody recorded (and days still to come)
  /// and approved anyway — how many, so the decision can be read later.
  assumedDays      Int?

  /// The employer as the payslips name it, copied at approval — a later change
  /// of address must not reach a payslip already issued.
  employerName    String?
  employerAddress String?

  /// Money sent: the day the salaries were credited, who recorded it, when.
  paidOn       DateTime? @db.Date
  paidByUserId String?
  paidAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
}

/// Where a run is in its life. The moves between them live in
/// domain/payroll/runStatus.ts and nowhere else:
///
///   draft ──approve──▶ approved ──mark paid──▶ paid
///     ▲                    │
///     └──────reopen────────┘
enum PayrollRunStatus {
  /// Calculated, not yet signed off. Can be recalculated or discarded.
  draft
  /// Signed off. Nothing about the month changes any more.
  approved
  /// Money sent. The payslips are statutory records from here on.
  paid
}

/// One employee's pay for one month, as it was calculated.
///
/// EVERYTHING IS COPIED, nothing is looked up. The name, the days, each line,
/// every rate the figures rested on: a payslip that joined to the current
/// salary or the current policy would silently start saying something else the
/// first time either changed.
model Payslip {
  id             String @id @default(uuid())
  organizationId String
  payrollRunId   String
  employeeId     String

  year  Int
  month Int

  /// Who they were that month. A later rename or promotion must not rewrite a
  /// payslip that has already been issued.
  employeeCode  String
  employeeName  String
  designation   String?
  department    String?
  dateOfJoining DateTime? @db.Date

  /// Which country's layout the payslip is printed in, and its currency —
  /// copied from the employee when it was calculated. Presentation only: the
  /// statutory arithmetic is India's whatever these say.
  country  String @default("IN")
  currency String @default("INR")

  /// The identifiers an Indian payslip must carry, copied at approval. Null
  /// means none was on record — never a placeholder, never derived.
  uan        String?
  pfMemberId String?
  esicNumber String?
  pan        String?

  /// The stored PDF, written once when the run is paid and never again: where
  /// it is, its SHA-256, and its size. Checked against the hash on every read.
  pdfKey         String?
  pdfSha256      String?
  pdfBytes       Int?
  pdfGeneratedAt DateTime? @db.Timestamptz(3)

  /// The calendar facts, in days.
  daysInMonth    Int
  /// Days of the month inside their employment — the whole month, unless they
  /// joined or left during it.
  employmentDays Int
  /// Days of loss of pay, from attendance and unpaid leave. Half days are real.
  lopDays        Decimal @db.Decimal(4, 1)
  /// employmentDays − lopDays. What the payslip says was paid for.
  paidDays       Decimal @db.Decimal(4, 1)
  /// Non-contributing period days, for the EPFO return: days of their
  /// employment this month for which no wages were paid.
  ncpDays        Decimal @db.Decimal(4, 1)

  /// How the pay was prorated: payableDays out of payBasisDays, on this basis.
  /// On a calendar basis they are simply paidDays out of daysInMonth.
  lopBasis     LopBasis
  payBasisDays Int
  payableDays  Decimal  @db.Decimal(4, 1)

  grossEarnings   Decimal @db.Decimal(12, 2)
  pfWages         Decimal @db.Decimal(12, 2)
  employeePf      Decimal @db.Decimal(12, 2)
  employeeEsi     Decimal @db.Decimal(12, 2)
  professionalTax Decimal @db.Decimal(12, 2)
  tds             Decimal @db.Decimal(12, 2)
  otherDeductions Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  /// Can be negative, and is kept that way: a negative net is a problem for a
  /// person to look at, and a zero would hide it.
  netPayable      Decimal @db.Decimal(12, 2)

  /// What the company paid on top, which never reaches the employee's net.
  employerPf  Decimal @db.Decimal(12, 2)
  employerEps Decimal @db.Decimal(12, 2)
  employerEpf Decimal @db.Decimal(12, 2)
  employerEsi Decimal @db.Decimal(12, 2)

  /// Every fact the figures rested on — which salary record, which policy,
  /// the rates, the ESI decision, EPS membership, the PT state, the TDS
  /// directive — so "why is my PF ₹1,800?" has an answer years later.
  basis    Json
  /// What the calculation had to assume around. Read before approving.
  warnings String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Cascade: discarding a draft run takes its payslips with it. A run that is
  /// not a draft cannot be discarded, which the service enforces.
  run          PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  /// NoAction: a payslip is a statutory record, and deleting the employee must
  /// not delete it. NoAction rather than Restrict so that deleting a whole
  /// organization can still cascade through both.
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction)
  lines        PayslipLine[]

  @@unique([organizationId, payrollRunId, employeeId])
  @@index([organizationId, employeeId, year, month])
}

/// One earning or deduction on a payslip, exactly as it was printed.
model PayslipLine {
  id             String @id @default(uuid())
  organizationId String
  payslipId      String

  kind  ComponentType
  code  String
  label String

  /// The full month's rate, for a line that was prorated from one. Null for an
  /// amount that is not a rate — a monthly entry, a statutory deduction.
  rate   Decimal? @db.Decimal(12, 2)
  amount Decimal  @db.Decimal(12, 2)

  displayOrder Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslip      Payslip      @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([organizationId, payslipId])
}

/// How much income tax to deduct from one employee each month — entered by
/// the accountant, never computed.
///
/// Manual mode, for v1 (guide, Day 16). A computed TDS engine with
/// declarations and Form 16 is explicitly out of scope; this is what lets the
/// company pay people lawfully without one. A run cannot start until everybody
/// in it has a directive for the month — including an explicit ₹0, with the
/// reason written down, so that no tax is ever skipped by omission.
///
/// Per financial year. A directive never carries into the next year: the tax
/// on a salary is an annual calculation, and last year's answer is not this
/// year's.
model EmployeeTdsDirective {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String

  /// The financial year, by the calendar year it starts in: 2026 is 2026–27.
  financialYear Int
  /// The first day of the month it applies from, until a later one replaces it.
  effectiveFrom DateTime @db.Date

  monthlyAmount Decimal @db.Decimal(12, 2)
  /// Required for ₹0 — "below the taxable limit under the new regime" — so a
  /// zero is a decision on record rather than a blank.
  reason        String?

  enteredByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One directive per employee per month it starts in. Entering another for
  /// the same month corrects it; the audit log keeps what it said before.
  @@unique([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, financialYear])
}

/// An amount entered for one employee for one month, against a component
/// whose entry is `monthly`.
///
/// The guide calls this EmployeeIncentive, and Incentive is the only monthly
/// component the client has. It takes any of them, because the catalogue
/// already can: a second one added in Settings should need no new table.
///
/// Never computed, never guessed, never carried forward. No row means no line
/// on the payslip — not a line reading zero.
model EmployeeMonthlyEntry {
  id                String @id @default(uuid())
  organizationId    String
  employeeId        String
  salaryComponentId String

  year  Int
  month Int

  /// Paid as entered: not prorated, whatever the attendance.
  amount Decimal @db.Decimal(12, 2)
  note   String?

  enteredByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// NoAction, as for salary amounts: a component somebody was paid under
  /// cannot be deleted out from under the record of it.
  component    SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction)

  @@unique([organizationId, employeeId, salaryComponentId, year, month])
  @@index([organizationId, year, month])
}

/// How this company's bank wants its bulk salary file laid out.
///
/// Every Indian bank's corporate portal has its own upload format — its own
/// column order, headers, date style and fixed codes such as NEFT. So the file
/// is described here rather than written in code: when the bank's sample
/// arrives, Accounts sets it up once, and a second bank is a second setup, not
/// a release.
///
/// One per company. No row means the built-in default.
model BankFileTemplate {
  id             String @id @default(uuid())
  organizationId String

  /// The columns, in order: each a header and what it holds — a field of the
  /// payment (name, account, IFSC, amount…) or a fixed text such as "NEFT".
  /// Checked against domain/payroll/bankFile.ts before it is saved.
  columns       Json
  includeHeader Boolean @default(true)
  /// DD/MM/YYYY, YYYY-MM-DD, DD-MM-YYYY or MM/DD/YYYY — for date columns.
  dateFormat    String  @default("DD/MM/YYYY")
  /// The remark each transfer carries, with {month}, {year} and {code} filled
  /// in: "Salary {month} {year}" → "Salary August 2026".
  narration     String  @default("Salary {month} {year}")
  /// Pay only into accounts somebody has checked. On by default: a salary
  /// sent to an unchecked account is money that may be gone.
  onlyVerified  Boolean @default(true)

  updatedByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
}
