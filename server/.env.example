# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Added on Day 2
# DATABASE_URL=""     # Neon POOLED connection string (app runtime)
# DIRECT_URL=""       # Neon DIRECT connection string (migrations, studio)

# Added on Day 15
# A throwaway LOCAL database that `npm run migration:new` replays migrations
# into. Prisma WIPES it on every use — never point it at DATABASE_URL or
# DIRECT_URL, or it wipes those instead. The script refuses if you try.
# Create it once:  CREATE DATABASE ems_shadow;
# SHADOW_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/ems_shadow"

# Added on Day 4
# JWT_ACCESS_SECRET=""      # 32+ characters
# JWT_REFRESH_SECRET=""     # 32+ characters, different from the above
# JWT_ACCESS_EXPIRY="15m"
# JWT_REFRESH_EXPIRY="7d"

# Added on Day 3
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_PASSWORD=""

# Added on Day 19 — where files live.
# Development keeps them on disk:
# STORAGE_DRIVER="local"
# STORAGE_PATH="./uploads"
#
# Production keeps them in Cloudflare R2 (a PRIVATE bucket, owned by the
# company's Cloudflare account). Create an R2 API token with "Object Read &
# Write" on that one bucket, then:
# STORAGE_DRIVER="r2"
# R2_ACCOUNT_ID=""           # Cloudflare dashboard → R2 → Account ID
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""               # e.g. careermap-hrms
# Check the credentials before going live:  npm run storage:check
