# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Added on Day 2
# DATABASE_URL=""     # Neon POOLED connection string (app runtime)
# DIRECT_URL=""       # Neon DIRECT connection string (migrations, studio)

# Added on Day 15
# A throwaway LOCAL database that `npm run migration:new` replays migrations
# into. Prisma WIPES it on every use — never point it at DATABASE_URL or
# DIRECT_URL, or it wipes those instead. The script refuses if you try.
# Create it once:  CREATE DATABASE ems_shadow;
# SHADOW_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/ems_shadow"

# Added on Day 4
# JWT_ACCESS_SECRET=""      # 32+ characters
# JWT_REFRESH_SECRET=""     # 32+ characters, different from the above
# JWT_ACCESS_EXPIRY="15m"
# JWT_REFRESH_EXPIRY="7d"

# Added on Day 3
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_PASSWORD=""

# Added on Day 19 — where files live.
# Development keeps them on disk:
# STORAGE_DRIVER="local"
# STORAGE_PATH="./uploads"
#
# Production keeps them in Cloudflare R2 (a PRIVATE bucket, owned by the
# company's Cloudflare account). Create an R2 API token with "Object Read &
# Write" on that one bucket, then:
# STORAGE_DRIVER="r2"
# R2_ACCOUNT_ID=""           # Cloudflare dashboard → R2 → Account ID
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""               # e.g. careermap-hrms
# Check the credentials before going live:  npm run storage:check

# Added on Day 20 — backups (npm run backup / restore / backup:drill; deploy/DEPLOY.md).
# Seals each dump. Generate once (openssl rand -base64 24) and keep it in the
# company's password manager, OFF the server: no backup opens without it.
# BACKUP_PASSPHRASE=""
# How many to keep: the newest N daily, and the first backup of each of N months.
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12
# Where pg_dump, pg_restore and psql live, if not on the PATH (Windows:
# C:\Program Files\PostgreSQL\17\bin). Not needed on the Ubuntu server.
# PG_BIN=""

# Added on Day 20 — the address the API listens on. Production defaults to
# 127.0.0.1, development to all. The Docker image sets 0.0.0.0 (deploy/compose.yml).
# HOST=""
# How many proxies stand in front of the API in production (default 1). The
# client's box has two — its shared Caddy, then EMS's web container — and
# deploy/compose.yml sets 2. Never more than there really are.
# TRUST_PROXY_HOPS=1

# ── Email (client §45) ───────────────────────────────────────────────────────
# Optional. Without SMTP_HOST and SMTP_FROM nothing is emailed; every notice
# still appears in the app's bell. Which notices are also emailed is chosen in
# Settings → Notifications. 587 with SMTP_SECURE=false upgrades with STARTTLS;
# use 465 with SMTP_SECURE=true for TLS from the start.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="CareerMap HR <hr@example.com>"
# Where the app is, for the link in each email. Defaults to CORS_ORIGIN.
# APP_URL=""
