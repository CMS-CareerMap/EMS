# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local file storage (development only — production uses Cloudflare R2)
uploads/

# The laptop rehearsal of the box (deploy/local/rehearse.sh): its .env holds secrets
deploy/local/.box/

# Environment variables
# Deny everything, then allow back the examples. Naming .env, .env.local and
# .env.*.local individually let .env.test through — and that holds a password too.
.env*
!.env.example
!.env.test.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.suo
*.sw?

# OS
.DS_Store
Thumbs.db

# Vite
*.local
.playwright-mcp/

# MCP config (contains secrets)
.mcp.json
