# /srv/ems/.env on the client's box — every setting of the EMS stack (deploy/compose.yml).
#
#   cp env.example .env && chmod 600 .env      then fill it in, on the box itself
#
# Never commit the filled-in file, never paste it into a chat or an email.
# docker compose stops with the setting's name if a required one is missing;
# the API checks the rest when it starts.
#
# An OPTIONAL setting you do not use: delete its line or leave it commented
# out — never leave it empty (NAME=). The API refuses an empty value.
#
# Generate each secret on the box — never type one: compose reads a `$` in a
# value as another setting's name, and the database password goes inside an
# address, where @ : / ? # % break it. These produce none of those:
#   openssl rand -hex 24      passwords (hex, so they are safe inside a URL)
#   openssl rand -hex 48      the two JWT secrets — run it twice, they must differ
#   openssl rand -base64 24   the backup passphrase

# ── The address ──────────────────────────────────────────────────────────────
# The domain only, no https:// — the site is https://<this>.
EMS_DOMAIN=ems.careermapsolutions.in

# ── The database (container `db`) ────────────────────────────────────────────
# The superuser's password: used only inside the database container.
POSTGRES_PASSWORD=
# The app's own login (`ems`). Both are read once, when the database is first
# created; changing them later here changes nothing (see DEPLOY.md).
EMS_DB_PASSWORD=

# ── Sign-in tokens ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Files: the company's Cloudflare R2 bucket (private) ──────────────────────
# Cloudflare dashboard → R2. The API token needs "Object Read & Write" on this
# one bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Backups ──────────────────────────────────────────────────────────────────
# Seals every nightly backup. A copy is kept by the company OFF this box (their
# password manager): if the box is lost, no backup opens without it.
BACKUP_PASSPHRASE=
# How many to keep (defaults: the newest 30 daily, the first of each of 12 months).
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12

# ── Email (optional) ─────────────────────────────────────────────────────────
# Without SMTP_HOST and SMTP_FROM nothing is emailed; every notice still
# appears in the app's bell. 587 with SMTP_SECURE=false upgrades with
# STARTTLS; use 465 with SMTP_SECURE=true for TLS from the start.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CareerMap HR <hr@example.com>"
